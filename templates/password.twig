<nav class="flex-accounts-breadcrumbs" aria-label="Път до страницата">
  <a href="/">Начало</a><span aria-hidden="true">/</span><a href="/account">Моят профил</a><span aria-hidden="true">/</span><span>Парола</span>
</nav>
<section class="flex-accounts-panel flex-accounts-dashboard" data-flex-accounts-page="password">
  <nav class="flex-accounts-nav" aria-label="Акаунт">
    <a href="/account">Профил</a>
    <a href="/account/password" aria-current="page">Парола</a>
    {% if show_orders %}<a href="/account/orders">Поръчки</a>{% endif %}
  </nav>
  {% if error %}<p class="flex-accounts-error" role="alert">{{ error }}</p>{% endif %}
  {% if message %}<p class="flex-accounts-message" role="status">{{ message }}</p>{% endif %}
  <form method="post" action="/account/password" class="flex-accounts-form">
    <input type="hidden" name="_token" value="{{ csrf_token }}">
    <div class="flex-accounts-fields">
      <label class="flex-accounts-field flex-field flex-label is-wide">Текуща парола
        <input class="flex-input" type="password" name="current_password" required maxlength="72" autocomplete="current-password">
      </label>
      <label class="flex-accounts-field flex-field flex-label is-wide">Нова парола
        <input class="flex-input" type="password" name="password" required maxlength="72" autocomplete="new-password">
      </label>
      <label class="flex-accounts-field flex-field flex-label is-wide">Потвърдете паролата
        <input class="flex-input" type="password" name="password_confirmation" required maxlength="72" autocomplete="new-password">
      </label>
    </div>
    <button type="submit" class="flex-btn flex-btn--primary flex-accounts-submit">Смени паролата</button>
  </form>
</section>
